
### down and parent walk an untracked branch to the trunk it rests on
$ git stack parent
develop
[exit 0]
$ git stack down
Switched to branch 'develop'
[exit 0]
HEAD: develop
$ git stack parent
main
[exit 0]
$ git stack down
Switched to branch 'main'
[exit 0]
HEAD: main

### down / up navigate the stack
$ git stack down
Switched to branch 'feat-a'
[exit 0]
HEAD: feat-a
$ git stack down
Switched to branch 'main'
[exit 0]
HEAD: main
$ git stack up
Switched to branch 'feat-b'
[exit 0]
HEAD: feat-b

### up with multiple children requires a choice
$ git stack up
'feat-a' has multiple children; pick one:
  git stack up feat-b
  git stack up feat-c
[exit 1]
$ git stack up feat-c
Switched to branch 'feat-c'
[exit 0]
HEAD: feat-c

### up and down round-trip through an untracked parent
$ git stack tree
* main (trunk)
    feat-b (1 commit(s)) (parent 'feat-a' is untracked)
      feat-c (1 commit(s))
[exit 0]
$ git stack up
Switched to branch 'feat-b'
[exit 0]
HEAD: feat-b
$ git stack parent
feat-a
(parent 'feat-a' is untracked)
[exit 0]
$ git stack down
(parent 'feat-a' is untracked)
Switched to branch 'feat-a'
[exit 0]
HEAD: feat-a
$ git stack down
Switched to branch 'main'
[exit 0]
HEAD: main

### parent and down name the untracked parent they walk to
$ git stack tree
  main (trunk)
  * feat-b (1 commit(s)) (parent 'feat-a' is untracked)
      feat-c (1 commit(s))
[exit 0]
$ git stack parent
feat-a
(parent 'feat-a' is untracked)
[exit 0]
$ git stack down
(parent 'feat-a' is untracked)
Switched to branch 'feat-a'
[exit 0]
HEAD: feat-a

### up lists a detached root alongside the trunk's tracked children
$ git stack tree
* main (trunk)
    other (1 commit(s))
    feat-b (1 commit(s)) (parent 'feat-a' is untracked)
[exit 0]
$ git stack up
'main' has multiple children; pick one:
  git stack up other
  git stack up feat-b
[exit 1]

### up offers a detached root only from the trunk its stack rests on
$ git stack tree
  main (trunk)
  develop (trunk)
    feat-b (1 commit(s)) (parent 'feat-a' is untracked)
[exit 0]
$ git stack up
error: no branch stacked on top of 'main'
[exit 1]
$ git stack up
Switched to branch 'feat-b'
[exit 0]
HEAD: feat-b

### parent notes a parent whose ref is gone
$ git stack tree
  main (trunk)
  * feat-b (parent 'feat-a' missing; run `git stack sync`)
[exit 0]
$ git stack parent
feat-a
(parent 'feat-a' missing; run `git stack sync`)
[exit 0]
$ git stack down
error: parent branch 'feat-a' no longer exists
[exit 1]

### up <name> reaches another trunk's detached root; the menu still refuses it
$ git stack tree
  main (trunk)
    m-b (1 commit(s)) (parent 'm-a' is untracked)
* develop (trunk)
[exit 0]
$ git stack up
error: no branch stacked on top of 'develop'
[exit 1]
$ git stack up m-b
Switched to branch 'm-b'
[exit 0]
HEAD: m-b

### tree and up agree on which trunk a detached root belongs to
$ git stack tree
  main (trunk)
    m-b (1 commit(s)) (parent 'm-a' is untracked)
* develop (trunk)
    d-b (1 commit(s)) (parent 'd-a' is untracked)
[exit 0]
$ git stack up
Switched to branch 'd-b'
[exit 0]
HEAD: d-b
$ git stack up
Switched to branch 'm-b'
[exit 0]
HEAD: m-b

### up refuses a detached root whose ref no longer exists (a phantom node)
$ git stack tree
* main (trunk)
    feat-b (parent 'feat-a' is untracked)
      feat-c (parent 'feat-b' missing; run `git stack sync`)
[exit 0]
$ git stack up
error: no branch stacked on top of 'main'
[exit 1]

### up orders a trunk's tracked child before its detached roots, sorted
$ git stack tree
* main (trunk)
    main-child (1 commit(s))
    aaa-b (1 commit(s)) (parent 'aaa-a' is untracked)
    zzz-b (1 commit(s)) (parent 'zzz-a' is untracked)
[exit 0]
$ git stack up
'main' has multiple children; pick one:
  git stack up main-child
  git stack up aaa-b
  git stack up zzz-b
[exit 1]
