# Hand-written type seed fed to Spinel via `--rbs` -- an INPUT. The emitted golden
# is test/git-stack.rbs.expected, and must never live under rbs/, or it would seed
# itself.
#
# Many methods take a branch name that Spinel unifies across call sites
# (`effective_parent`'s result, `containing_trunk`'s, the trunk list). Left to
# inference, those parameters widen to untyped: the slow path, and new lines in
# the golden. Most pins below restate what an earlier compiler inferred unaided,
# re-asserted after a bump widened them.
#
# Every entry must be a FAITHFUL assertion -- branch names, colour text, packed
# lists and the trunk list are String / Array[String] at every call site. A pin
# that disagrees with how the compiler builds a value does not narrow it, it
# reinterprets it. That is why `ahead_behind_columns` / `ahead_behind_readback`
# are deliberately absent: on a ref that builds their hashes poly (spinel 328a5ac)
# the old `Hash[String, Integer]` pin compiles into a segfault, whereas unpinned
# they just widen and the ratchet fails. A golden that shows a signature proves
# only that the OLD compiler inferred it.
#
# Pins are kept even when today's compiler no longer needs them: a redundant pin
# is cheap, and it turns the next bump's widening into a golden diff rather than a
# quiet slowdown. `rbs/paint.rbs` was once deleted as redundant and had to come
# back one bump later.
#
# `live_trunks` guards a crash rather than a golden line: widened, it makes
# `trunk_branches` return two array representations that callers unbox with one
# unchecked cast, and the first `trunk?` segfaults (17447ac).
class Object
  def sh: (String) -> String
  def branch_ref: (String) -> String
  def checkout!: (String) -> nil
  def branch_name_taken?: (String) -> bool
  def branch_ref_exists?: (String) -> bool
  def ahead_behind: (String, String) -> Array[Integer]
  def paint: (String, String) -> String
  def green: (String) -> String
  def cyan: (String) -> String
  def set_trunks: (Array[String]) -> Array[String]
  def live_trunks: (Array[String]) -> Array[String]
  def trunk_branches: () -> Array[String]
  def is_trunk?: (String, Array[String]) -> bool
  def containing_trunk: (String, Array[String]) -> String
  def effective_parent: (String, Array[String]) -> String
  def set_parent: (String, String) -> bool
  def clear_parent: (String) -> bool
  def get_base: (String) -> String
  def set_base: (String, String) -> bool
  def clear_base: (String) -> bool
  def record_tip_base: (String, String) -> nil
  def untrack!: (String) -> nil
  def restack_subtree: (String, Array[String], bool, String, StackTopology) -> nil
  def children_of: (String, Array[String]) -> Array[String]
  def named_children_of: (String, Array[String]) -> Array[String]
  def tree_marker: (String, String) -> String
  def tree_name: (String, String, String) -> String
  def pack_lines: (Array[String]) -> String
  def parent_note: (String, StackTopology) -> String
  def print_parent_note: (String, Array[String]) -> nil
  def print_tree_row: (String, Integer, String, StackSnapshot) -> nil
  def resolve_stack_base: (String, String) -> String
  def replay_onto!: (String, String, String) -> nil
end

# The ivar pins hold the fields every reader widens with: a widened `@children`
# takes `order`, `walk_order`, `detached_roots`, `print_order` and `cmd_tree`
# down with it. One pin per field instead of one per reader.
#
# They are expressible only because `@children` and `@ab` are packed Strings. A
# `Hash[String, Array[String]]` pin is silently dropped -- neither applied nor
# refused -- so it would read like a guarantee while guaranteeing nothing (see
# pack_lines in bin/git-stack.rb).
class StackTopology
  @parents: Hash[String, String]
  @children: Hash[String, String]
  def branch?: (String) -> bool
  def parent_of: (String) -> String
  def children_of: (String) -> Array[String]
  def detached_roots: () -> Array[String]
  def live_detached_roots: () -> Array[String]
  def tracked_branches: () -> Array[String]
  def parent_missing?: (String) -> bool
  def untracked_parent?: (String) -> bool
  def reconnect_target: (String, String) -> String
  def stack_root: (String) -> String
  def would_cycle?: (String, String) -> bool
  def validate_new_parent!: (String, String, String) -> nil
  def load: (String) -> nil
  def self.from_scan: (Set, Array[String], String) -> StackTopology
end

class StackSnapshot
  @topology: StackTopology
  @ab: Hash[String, String]
  def topology: () -> StackTopology
  def ahead_behind_of: (String) -> Array[Integer]
end

class StackRepository
  def self.load_topology: (Array[String]) -> StackTopology
  def self.load_snapshot: (Array[String]) -> StackSnapshot
end

# Our only callers pass `order_branches`'s Array[String]; without this the element
# type is lost on the way in.
class Set
  def merge: (Array[String]) -> Set
end
